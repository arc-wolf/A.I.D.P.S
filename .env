# A.I.D.P.S Environment Configuration
# Copy from .env.example and customize for your network

# Network scanning
SCAN_SUBNET=192.168.204.0/24,192.168.205.0/24
SCAN_TIMEOUT=3

# Database
SQLITE_DB=aidps_inventory.db
MONGO_URI=mongodb://root:example@localhost:27017/
MONGO_DB=aidps

# Web app
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development

# Default credentials for provisioning (update for your lab)
DEFAULT_SSH_USER=admin
DEFAULT_SSH_PASSWORD=your-ssh-password
DEFAULT_WINRM_USER=Administrator
DEFAULT_WINRM_PASSWORD=your-winrm-password

# Scheduler
SCHEDULE_TIME=18:00

# Ansible
ANSIBLE_INVENTORY=./inventory.ini

