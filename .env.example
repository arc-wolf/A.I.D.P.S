# A.I.D.P.S Configuration

# Network
SCAN_SUBNET=192.168.1.0/24
SCAN_TIMEOUT=3

# Database
SQLITE_DB=aidps_inventory.db
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=aidps

# Web
SECRET_KEY=your-secret-key-change-me
FLASK_ENV=development

# Credentials (generate securely)
DEFAULT_SSH_USER=admin
DEFAULT_SSH_PASSWORD=change-me
DEFAULT_WINRM_USER=Administrator
DEFAULT_WINRM_PASSWORD=change-me

# Scheduler
SCHEDULE_TIME=18:00

# Ansible
ANSIBLE_INVENTORY=./inventory.ini

