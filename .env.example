# A.I.D.P.S configuration
# Copy to .env and replace every placeholder before starting the app.

# Network
SCAN_SUBNET=192.168.1.0/24
SCAN_TIMEOUT=3

# Database
SQLITE_DB=aidps_inventory.db
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=aidps

# Web: generate a unique secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FLASK_ENV=development
SESSION_COOKIE_SECURE=false

# Dashboard login (no default account is created)
AIDPS_ADMIN_USERNAME=admin
AIDPS_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Remote device credentials (optional; prefer dedicated least-privilege accounts)
DEFAULT_SSH_USER=
DEFAULT_SSH_PASSWORD=
DEFAULT_WINRM_USER=
DEFAULT_WINRM_PASSWORD=

# Scheduler
SCHEDULE_TIME=18:00

# Ansible
ANSIBLE_INVENTORY=./inventory.ini
